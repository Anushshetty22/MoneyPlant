# PostgreSQL
POSTGRES_DB=moneyplant
POSTGRES_USER=moneyplant
POSTGRES_PASSWORD=change-me-locally
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Go API
API_HOST=0.0.0.0
API_PORT=8080

# Optional live monitoring
# Leave the symbol empty to keep the API read-only without a WebSocket connection.
LIVE_MONITOR_SYMBOL=
# Comma-separated symbols for independent Binance monitors. When set, this
# takes precedence over LIVE_MONITOR_SYMBOL.
LIVE_MONITOR_SYMBOLS=
LIVE_MONITOR_MAX_RETRIES=3
LIVE_MONITOR_WS_URL=wss://stream.binance.com:9443

# Market-data providers
ANGEL_ONE_API_KEY=
ANGEL_ONE_CLIENT_CODE=
ANGEL_ONE_PASSWORD=
ANGEL_ONE_TOTP_SECRET=

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
